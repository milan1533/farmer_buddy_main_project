# MongoDB Configuration (Legacy)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=farm0

# Supabase Configuration (New - PostgreSQL Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Migration Control
DB_MODE=mongodb                    # Options: 'mongodb' or 'supabase'
DUAL_MODE_ENABLED=false            # Enable to query both databases during transition

# Supabase Storage
SUPABASE_STORAGE_BUCKET=farm-fresh-uploads

# Authentication & Security
SECRET_CODE=your-super-secret-jwt-key-here-change-this-in-production
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
CHATBOT_API_KEY=your-chatbot-api-key
